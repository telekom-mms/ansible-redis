#!/bin/sh
# This script is generated by Ansible to reconfigure Sentinel while running.
{% set cli = "/usr/bin/redis-cli -p " + (redis_sentinel_port|string) %}

{% for primary in redis_sentinel_monitors -%}
{{ cli }} sentinel monitor {{ primary.name }} `dig +short {{ primary.host }}` {{ primary.port }} {{ primary.quorum|d('2') }}
{% for option in ('auth_pass', 'down_after_milliseconds', 'parallel_syncs', 'failover_timeout', 'notification_script', 'client_reconfig_script') -%}
{% if primary[option] is defined and primary[option] -%}
{{ cli }} sentinel set {{ primary.name }} {{ option|replace('_', '-') }} {{ primary[option] }}
{% endif %}
{% endfor -%}
{% endfor -%}
